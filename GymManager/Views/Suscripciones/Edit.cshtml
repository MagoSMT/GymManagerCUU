
@model GymManager.Models.Suscripcion

@{
    ViewData["Title"] = "Editar suscripción";

    var socios = ViewBag.Socios as List<GymManager.Models.Socio>;
    var planes = ViewBag.Planes as List<GymManager.Models.Plan>;
}

<div class="socios-page">

    <div class="socios-header">
        <div>
            <h2>Editar suscripción</h2>
            <p>Modifica la información de la membresía.</p>
        </div>
    </div>

    <div class="socios-panel">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.IdSuscripcion" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-grid-gym">

                <div class="form-group-gym">
                    <label>Socio</label>
                    <select name="idSocio" required>
                        @if (socios != null)
                        {
                            foreach (var socio in socios)
                            {
                                <option value="@socio.IdSocio"
                                    selected="@(socio.IdSocio == Model.IdSocio)">
                                    @socio.Nombre @socio.Apellidos
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group-gym">
                    <label>Plan</label>
                    <select name="idPlan" required>
                        @if (planes != null)
                        {
                            foreach (var plan in planes)
                            {
                                <option value="@plan.IdPlan"
                                    selected="@(plan.IdPlan == Model.IdPlan)">
                                    @plan.Nombre - @plan.Precio.ToString("C")
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group-gym">
                    <label>Fecha de inicio</label>
                    <input type="date" name="fechaInicio"
                           value="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                           required />
                </div>

                <div class="form-group-gym">
                    <label>Fecha de vencimiento</label>
                    <input type="date" name="fechaFin"
                           value="@Model.FechaFin.ToString("yyyy-MM-dd")"
                           required />
                </div>

                <div class="form-group-gym">
                    <label>Precio contratado</label>
                    <input type="number" name="precioContratado"
                           value="@Model.PrecioContratado"
                           step="0.01" min="0.01" required />
                </div>

                <div class="form-group-gym">
                    <label>Estado</label>
                    <select name="estado" required>
                        @foreach (var estado in new[] {
                            "Pendiente", "Activa", "Vencida", "Cancelada"
                        })
                        {
                            <option value="@estado"
                                selected="@(Model.Estado == estado)">
                                @estado
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group-gym full-width">
                    <label>Observaciones</label>
                    <textarea name="observaciones" rows="4"
                              maxlength="500">@Model.Observaciones</textarea>
                </div>

            </div>

            <div class="form-actions-gym">
                <a asp-action="Index" class="btn-cancel-gym">
                    Cancelar
                </a>

                <button type="submit" class="btn-primary-gym">
                    Guardar cambios
                </button>
            </div>

        </form>

    </div>
</div>
