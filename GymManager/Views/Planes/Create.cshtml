
@model GymManager.Models.Plan

@{
    ViewData["Title"] = "Crear plan";
}

<div class="socios-page">

    <div class="socios-header">
        <div>
            <h2>Crear nuevo plan</h2>
            <p>Configura una nueva membresía para tu gimnasio.</p>
        </div>

        <a asp-action="Index" class="btn-primary-gym">
            Volver a planes
        </a>
    </div>

    <div class="socios-panel">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-grid-gym">

                <div class="form-group-gym">
                    <label asp-for="Nombre">Nombre del plan</label>
                    <input asp-for="Nombre" placeholder="Ej. Mensual" />
                    <span asp-validation-for="Nombre"></span>
                </div>

                <div class="form-group-gym">
                    <label asp-for="Precio">Precio ($)</label>
                    <input asp-for="Precio" type="number"
                           step="0.01" min="0.01" placeholder="Ej. 500.00" />
                    <span asp-validation-for="Precio"></span>
                </div>

                <div class="form-group-gym">
                    <label asp-for="DuracionDias">Duración en días</label>
                    <input asp-for="DuracionDias" type="number"
                           min="1" placeholder="Ej. 30" />
                    <span asp-validation-for="DuracionDias"></span>
                </div>

                <div class="form-group-gym full-width">
                    <label asp-for="Descripcion">Descripción</label>
                    <textarea asp-for="Descripcion" rows="4"
                              placeholder="Describe los beneficios del plan..."></textarea>
                    <span asp-validation-for="Descripcion"></span>
                </div>

            </div>

            <div class="form-actions-gym">
                <a asp-action="Index" class="btn-cancel-gym">Cancelar</a>

                <button type="submit" class="btn-primary-gym">
                    Guardar plan
                </button>
            </div>

        </form>

    </div>
</div>
